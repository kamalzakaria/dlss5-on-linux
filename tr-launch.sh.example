#!/usr/bin/env bash
# Tomb Raider I-III Remastered -- OpenGL rendered through Vulkan via Mesa's PE-side Zink.
#
# Why: DLSS5-Feeder's OpenGL transport cannot work under Wine -- neither a D3D12 fence nor a
# D3D12 resource imports into GL (GL_INVALID_ENUM on both; DLSS5-Feeder issue #121). Its
# Vulkan transport imports the fence as a Vulkan timeline semaphore instead, which under
# vkd3d-proton is the same kind of object. So: put Mesa's Windows opengl32.dll (Gallium WGL,
# driver = zink) beside the exe. The game still calls OpenGL, but zink turns it into Vulkan
# inside the Wine process (winevulkan), and the Vulkan-side tooling can see it.
#
# Mesa: pal1000/mesa-dist-win 26.1.8 msvc x64 -- opengl32.dll + libgallium_wgl.dll, copies in
# ~/Games/mesa-zink-x64. The previous ReShade-as-opengl32 is parked in _opengl-reshade-setup/.
#
# Stages (TR_STAGE, default below):
#   A  zink only, GALLIUM_HUD on-screen fps -- does the game run on zink at all?   [PASSED]
#   B  + ReShade as a Vulkan layer. Wine's builtin vulkan-1.dll forwards straight to the HOST
#      loader, which cannot load a Windows-side layer, so the real Khronos loader
#      (NuGet Silk.NET.Vulkan.Loader.Native, x64) sits beside the exe; it finds the GPU through
#      winevulkan.json, which Proton registers under HKLM\Software\Khronos\Vulkan\Drivers.
#      ReShade64.dll + VkLayer_reshade.json live in _vklayers/.   [PASSED]
#   C  + DLSS5-Feeder 1.17 (Vulkan transport) + dlssnr-linux + RTX40-patched model.   [WORKS]
#      Measured at 5120x1440: zink+ReShade 132 fps, + plain DLAA 88 fps, + DLSS 5 NR 31 fps.
#      The D3D12 fence imports as a Vulkan timeline semaphore (in=OK out=OK) -- the import that
#      is impossible on the GL path (DLSS5-Feeder #121).
set -uo pipefail
STAGE="${TR_STAGE:-C}"
LOG=/home/kamal/.config/tr-launch.log
exec 3>&1; exec >>"$LOG" 2>&1
echo "--- $(date '+%F %T') stage=$STAGE ---"

export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}opengl32=n,b"
export GALLIUM_DRIVER=zink          # never fall back silently: zink or nothing

export GALLIUM_HUD="fps"            # on-screen proof that Mesa, not the NVIDIA GL driver, is drawing
# ...and the same readings written to disk, so they can be measured without anyone watching.
# Frame rate measured by Wine itself: winevulkan times every vkQueuePresentKHR, which is how
# zink presents. Lands in tr-launch.log as "@ approx N fps". (Mesa's GALLIUM_HUD_DUMP_DIR writes
# nothing under Wine.)
[ "${TR_FPS:-1}" = 1 ] && export WINEDEBUG="${WINEDEBUG:+$WINEDEBUG,}fps"

case "$STAGE" in
  A) ;;
  B|C)
    export WINEDLLOVERRIDES="$WINEDLLOVERRIDES;vulkan-1=n,b"
    # The layer is found via the REGISTRY, not VK_LAYER_PATH/VK_ADD_LAYER_PATH: Wine processes
    # run elevated, and the Khronos loader ignores every path env var when elevated ("Loader is
    # running with elevated permissions. Environment variable %s will be ignored"). Registered once
    # in this game's prefix: HKLM\Software\Khronos\Vulkan\ExplicitLayers ->
    #   S:\steamapps\common\Tomb Raider I-III Remastered\_vklayers\VkLayer_reshade.json = 0
    # VK_INSTANCE_LAYERS is a name list, not a path, so it is still honoured.
    export VK_INSTANCE_LAYERS=VK_LAYER_reshade_1
    [ "${TR_TRACE:-0}" = 1 ] && export WINEDEBUG="${WINEDEBUG:+$WINEDEBUG,}+loaddll"   # confirm ReShade64.dll is actually loaded
    export VK_LOADER_DEBUG="${TR_VKDEBUG:-error}"  # loader diagnostics -> tr-launch.log
    ;;
esac

# DLSS 5's neural pass needs a few GB of VRAM at 5120x1440. ComfyUI idling with models loaded
# holds ~7.6 GB, which pushes the driver into paging over PCIe: measured 2 fps (GPU "100%" at
# 80 W) vs 31 fps (190 W) with it freed. Ask it to unload; harmless if it is not running, and
# ComfyUI defers the unload until any running job finishes.
if [ "$STAGE" = C ] && [ "${TR_FREE_COMFY:-1}" = 1 ]; then
    curl -s -m 3 -o /dev/null -X POST http://127.0.0.1:8188/free -H 'Content-Type: application/json' \
         -d '{"unload_models":true,"free_memory":true}' && echo "asked ComfyUI to free its VRAM"
fi

echo "exec: $*"
exec >&3 3>&-
exec "$@"
